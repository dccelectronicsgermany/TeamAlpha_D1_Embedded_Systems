          <mxGeometry x="650" y="535" width="890" height="172" as="geometry" />
        </mxCell>
        <mxCell id="n34" value="Button processing — before every switch evaluation" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#18324D;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="666" y="547" width="858" height="28" as="geometry" />
        </mxCell>
        <mxCell id="n35" value="checkButton() accepts a reading after ≥ 30 ms without a raw signal change.&#10;A stable HIGH → LOW edge sets pedestrianRequest = true when state ≠ PED_GREEN.&#10;The request stays stored after button release; presses during PED_GREEN are ignored.&#10;Holding the button does not repeatedly create requests." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#23384D;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="666" y="583" width="858" height="116" as="geometry" />
        </mxCell>
        <mxCell id="n36" value="" style="rounded=0;arcSize=12;whiteSpace=wrap;html=0;fillColor=#F2F5F8;strokeColor=#6683A0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="650" y="747" width="890" height="172" as="geometry" />
        </mxCell>
        <mxCell id="n37" value="Transition semantics" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#18324D;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="666" y="759" width="858" height="28" as="geometry" />
        </mxCell>
        <mxCell id="n38" value="Each arrow calls changeState(target): state = target; lastChange = millis();&#10;then the target entry action runs. No guard true → stay in the current state.&#10;RED → PED_GREEN has no timed wait. After YELLOW → RED, the stored request&#10;is served on the next update(). No additional all-red delay is implemented." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#23384D;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="666" y="795" width="858" height="116" as="geometry" />
        </mxCell>
        <mxCell id="n39" value="" style="rounded=0;arcSize=12;whiteSpace=wrap;html=0;fillColor=#F2F5F8;strokeColor=#6683A0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="650" y="959" width="890" height="172" as="geometry" />
        </mxCell>
        <mxCell id="n40" value="Safety and timing" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=17;fontColor=#18324D;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="666" y="971" width="858" height="28" as="geometry" />
        </mxCell>
        <mxCell id="n41" value="GREEN ⇒ pedestrian RED. PED_GREEN ⇒ car RED.&#10;On a request: car GREEN lasts at least 10 s; car YELLOW lasts at least 5 s.&#10;Without a request: RED, GREEN and YELLOW each last 20 s.&#10;PED_GREEN lasts 13 s, then RED starts a new 20 s timer unless another request arrives." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#23384D;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="666" y="1007" width="858" height="116" as="geometry" />
        </mxCell>
        <mxCell id="n42" value="Timing uses state-entry time.&#10;A late request does not restart&#10;the 10 s / 5 s minimum." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#23384D;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="1090" width="440" height="72" as="geometry" />
        </mxCell>
        <mxCell id="n43" value="TASK 2  /  Traffic Light System  /  Model of the supplied Arduino code" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=13;fontColor=#63788A;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="50" y="1218" width="1560" height="24" as="geometry" />
        </mxCell>
      </root>
